rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidDriver(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.bus is string && data.bus.size() <= 64 &&
             data.pin is string && data.pin.size() <= 16 &&
             (data.status == 'active' || data.status == 'locked');
    }

    function isValidTrip(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() <= 128 &&
             data.bus is string && data.bus.size() <= 64 &&
             (data.status == 'in_progress' || data.status == 'completed') &&
             data.createdAt is number;
    }

    function isValidExtra(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() <= 128 &&
             data.bus is string && data.bus.size() <= 64 &&
             data.createdAt is number;
    }

    function isValidExpense(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.driverName is string && data.driverName.size() <= 128 &&
             data.bus is string && data.bus.size() <= 64 &&
             data.type is string && data.type.size() <= 64 &&
             data.amount is number &&
             data.createdAt is number;
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(driverId) && isValidDriver(incoming());
    }

    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(tripId) && isValidTrip(incoming());
      allow update: if isSignedIn() && isValidId(tripId) && isValidTrip(incoming());
      allow delete: if isSignedIn() && isValidId(tripId);
    }

    match /extras/{extraId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(extraId) && isValidExtra(incoming());
      allow update: if isSignedIn() && isValidId(extraId) && isValidExtra(incoming());
      allow delete: if isSignedIn() && isValidId(extraId);
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming());
      allow delete: if isSignedIn() && isValidId(expenseId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
